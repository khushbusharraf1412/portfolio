<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= portfolioData.name %>'s Portfolio</title>
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }
        .header {
            background-color: #007bff;
            color: white;
            padding: 50px 0;
            text-align: center;
        }
        .section-title {
            text-align: center;
            margin-bottom: 40px;
            font-size: 2rem;
        }
        .card {
            transition: transform 0.3s ease;
        }
        .card:hover {
            transform: scale(1.05);
        }
        footer {
            background-color: #007bff;
            color: white;
            padding: 20px 0;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header class="header">
        <div class="container text-center">
            <img src="/images/khushboo.jpg" alt="Khushbu Sharrof" class="rounded-circle mb-3" width="150">
            <h1 class="display-4"><%= portfolioData.name %></h1>
            <p class="lead">Full Stack Developer | BCA Student</p>
        </div>
    </header>

    <!-- About Section -->
    <section id="bio" class="container my-5" data-aos="fade-up">
        <div class="row">
            <div class="col-lg-6">
                <h2 class="section-title">About Me</h2>
                <p><%= portfolioData.bio %></p>
            </div>
            <div class="col-lg-6">
                <h2 class="section-title">Skills</h2>
                <ul class="list-group">
                    <% portfolioData.skills.forEach(skill => { %>
                        <li class="list-group-item"><%= skill %></li>
                    <% }); %>
                </ul>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="container my-5" data-aos="fade-up">
        <h2 class="section-title">Projects</h2>
        <div class="row">
            <% portfolioData.projects.forEach(project => { %>
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><%= project.name %></h5>
                            <p class="card-text">Technologies: <%= project.tech.join(', ') %></p>
                            <a href="<%= project.link%>" class="btn btn-primary" target="_blank">View Project</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- Contact Section -->
    <!-- <section id="contact" class="container my-5">
        <h2 class="section-title">Contact</h2>
        <form action="POST" method="POST">
            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" class="form-control" id="name" placeholder="Your Name">
            </div>
            <div class="form-group">
                <label for="email">Email address</label>
                <input type="email" class="form-control" id="email" placeholder="Your Email">
            </div>
            <div class="form-group">
                <label for="message">Message</label>
                <textarea class="form-control" id="message" rows="3" placeholder="Your Message"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Send Message</button>
        </form>
    </section> -->

    <!-- Footer Section -->
    <footer>
        <div class="container text-center">
            <p>GitHub: <a href="<%= portfolioData.github %>" class="text-white"><i class="fab fa-github"></i> GitHub</a></p>
            <p>LinkedIn: <a href="<%= portfolioData.linkedin %>" class="text-white"><i class="fab fa-linkedin"></i> LinkedIn</a></p>
            <p>Email: <%= portfolioData.email %></p>
        </div>
    </footer>

    <!-- Bootstrap JS and Dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init();
    </script>

</body>
</html>